{
	"private": true,
	"name": "timekeeper",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"dev": "export NODE_OPTIONS=--openssl-legacy-provider; preact watch",
		"deploy": "bun run build && firebase deploy --only hosting",
		"build": "export NODE_OPTIONS=--openssl-legacy-provider; preact build",
		"serve": "export NODE_OPTIONS=--openssl-legacy-provider; sirv build --port 8080 --cors --single",
		"lint": "export NODE_OPTIONS=--openssl-legacy-provider; eslint src"
	},
	"eslintConfig": {
		"extends": "preact",
		"ignorePatterns": [
			"build/"
		]
	},
	"devDependencies": {
		"eslint": "^6.8.0",
		"eslint-config-preact": "^1.3.0",
		"preact-cli": "^3.3.5",
		"sirv-cli": "^1.0.3"
	},
	"dependencies": {
		"firebase": "^9.8.1",
		"preact": "^10.7.2",
		"preact-render-to-string": "^5.2.0",
		"preact-router": "^3.2.1",
		"xlsx-js-style": "^1.2.0"
	}
}
